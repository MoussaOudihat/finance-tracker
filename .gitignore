data/*.db
data/*.db-shm
data/*.db-wal

# Données SQL exportées / seed (contiennent des données réelles)
data/*.sql

# Fichiers Excel personnels à la racine
*.xlsx
*.xls

# Dossier data entier sauf .gitkeep
data/*
!data/.gitkeep

