# Configuration de l'interface web Fintrack — copier en .env (jamais committé).

# Clé de signature des cookies de session (32+ caractères aléatoires) :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FINTRACK_SECRET_KEY=

# "supabase" : connexion avec les comptes Supabase de l'app desktop (données synchronisées)
# "local"    : un seul compte défini ci-dessous, données uniquement dans le volume
FINTRACK_AUTH_MODE=supabase

# Mode supabase — mêmes valeurs que dans Paramètres > Synchronisation de l'app desktop
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Mode local — hash bcrypt généré avec : python -m web.hash_password
# Entre apostrophes : le hash contient des "$" que docker compose interpréterait.
FINTRACK_WEB_USER=
FINTRACK_WEB_PASSWORD_HASH=''

# "0" uniquement pour tester en http://localhost (sinon le cookie exige HTTPS)
FINTRACK_COOKIE_SECURE=0
