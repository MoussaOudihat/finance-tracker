# Configuration NON secrète (les secrets sont dans deploy/compose/secrets/,
# générés par `python deploy/gen_secrets.py`).

SUPABASE_URL=https://xxxxxxxx.supabase.co

# "0" uniquement pour tester en http://localhost ; laisser "1" derrière HTTPS
FINTRACK_COOKIE_SECURE=0
FINTRACK_LOG_LEVEL=INFO

# Adresse autorisée à fournir X-Forwarded-For (IP réelle du client, pour la
# limitation des tentatives de connexion) : la passerelle du réseau `egress`
# par laquelle arrive le port publié. Le port n'étant publié que sur
# 127.0.0.1, seul le reverse proxy local peut l'atteindre.
# Podman rootless : vérifier l'adresse source dans `logs web` et l'indiquer ici.
FORWARDED_ALLOW_IPS=172.30.0.1

# IA : modèles (les clés sont dans secrets/anthropic_api_key, secrets/gemini_api_key)
CLAUDE_MODEL=claude-opus-5-5
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=40

# TickTick (app créée sur https://developer.ticktick.com ; secret dans secrets/)
TICKTICK_CLIENT_ID=
TICKTICK_REDIRECT_URI=http://localhost:8080/parametres/ticktick/callback

# Notifications : hôtes autorisés pour ntfy / webhooks (anti-SSRF)
NOTIFIER_ALLOWED_HOSTS=ntfy.sh,discord.com,discordapp.com,hooks.slack.com

# Serveur MCP (profil « mcp ») : URL publique servie par le reverse proxy TLS,
# et hôtes https autorisés comme retour OAuth (page de consentement du web)
MCP_PUBLIC_URL=https://fintrack.example.com/mcp
MCP_EXPOSE_DETAILS=true
OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com
